# Las demos NO necesitan API key: usan tus credenciales de AWS (aws login) y generan
# llaves temporales de Bedrock solas.

# Opcional: si un antivirus o proxy inspecciona HTTPS (Avast, Zscaler...), apunta a su certificado
# AWS_CA_BUNDLE=C:\Users\tu-usuario\.aws\ca-bundle.pem

# Opcional (solo main.py): llave fija del endpoint de Bedrock compatible con OpenAI.
# Las de corto plazo ("bedrock-api-key-...") vencen en 12 horas.
OPENAI_API_KEY=tu-api-key-de-bedrock
OPENAI_BASE_URL=https://bedrock-mantle.us-east-2.api.aws/v1
